PORT=5001
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Required — set these yourself. There are no default admin credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/inveris?retryWrites=true&w=majority

# Private API key is required for uploads (starts with private_)
IMAGEKIT_PRIVATE_KEY=
# Optional — from ImageKit dashboard, not used by the API today
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# Contact / careers / newsletter notifications (Resend)
CONTACT_NOTIFY_EMAIL=vanshagarwal0144@gmail.com
# Optional extra inbox for career applications (comma-separated is allowed)
CAREERS_NOTIFY_EMAIL=
RESEND_API_KEY=re_xxxxxxxx
# Must be an API key from the same Resend account where the domain is verified.
RESEND_FROM_EMAIL=Inveris Solutions <noreply@inverissolutions.com>
